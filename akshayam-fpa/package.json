{
  "name": "akshayam-fpa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node db/setup.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env.local db/migrate.mjs --reset",
    "fixtures": "node scripts/make-fixtures.mjs ./storage/fixtures",
    "test:parsers": "tsx scripts/check-parsers.mts ./storage/fixtures",
    "test:statements": "tsx scripts/check-statements.mts",
    "seed:admin": "node --env-file-if-exists=.env.local db/seed-admin.mjs",
    "seed:reviewers": "node --env-file-if-exists=.env.local db/seed-vertical-reviewers.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "next": "16.3.2",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
